# OpenAI API Key (필수)
# https://platform.openai.com/api-keys 에서 발급받으세요
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) API Key (필수)
# https://console.anthropic.com/ 에서 발급받으세요
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 카카오맵 REST API Key (필수)
# https://developers.kakao.com/ 에서 앱 생성 후 발급받으세요
# 카카오맵 API는 주소→좌표 변환, 주변 시설 검색에 사용됩니다
KAKAO_API_KEY=your_kakao_api_key_here

# 공공데이터포털 API Key (선택사항)
# https://www.data.go.kr/ 에서 "아파트매매 실거래 상세 자료" API 신청
# 실거래가 정보 조회에 사용됩니다 (없어도 동작하지만 정확도 감소)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here
